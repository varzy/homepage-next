{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "ignorePatterns": ["packages/**"],
  "sortTailwindcss": {
    "preserveDuplicates": true,
    "preserveWhitespace": true
  },
  "sortImports": {
    "newlinesBetween": false
  },
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
