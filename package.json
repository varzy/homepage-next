    "migrate:upload": "tsx scripts/upload-legacy-to-r2.ts",
    "migrate:rewrite": "tsx scripts/rewrite-notion-urls.ts",
    "migrate:smms": "tsx scripts/migrate-smms-to-r2.ts",
    "restore:notion": "tsx scripts/restore-notion-from-md.ts",
