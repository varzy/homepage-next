{
  "name": "homepage-next",
  "version": "3.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:debug": "next build  --debug",
    "release": "git pull && pnpm fetch:all && pnpm run format && pnpm run exam && git add . && git commit -m 'Release.' && git push",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "exam": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test",
    "fetch:posts": "tsx scripts/fetch-posts.ts",
    "fetch:kotoba": "tsx scripts/fetch-kotoba.ts",
    "fetch:taste": "tsx scripts/fetch-taste.ts",
    "fetch:pages": "tsx scripts/fetch-pages.ts",
    "fetch:all": "pnpm run fetch:pages && pnpm run fetch:posts && pnpm run fetch:kotoba && pnpm run fetch:taste",
    "sync:posts": "tsx scripts/fetch-posts.ts -- --full-sync",
    "sync:kotoba": "tsx scripts/fetch-kotoba.ts -- --full-sync",
    "sync:taste": "tsx scripts/fetch-taste.ts -- --full-sync",
    "sync:pages": "tsx scripts/fetch-pages.ts -- --full-sync",
    "sync:all": "pnpm run sync:posts && pnpm run sync:kotoba && pnpm run sync:taste && pnpm run sync:pages",
    "no2tg:release": "pnpm --filter no2tg2 release",
    "imgtiny:compress": "pnpm --filter imgtiny compress",
    "exam:all": "pnpm --filter \"*\" run exam"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.6",
    "@notionhq/client": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@zy/notion-images": "workspace:*",
    "clsx": "^2.1.1",
    "dayjs": "catalog:",
    "dotenv": "^18.0.10",
    "glob": "^14.0.4",
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "notion-to-md": "^3.1.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "tailwindcss": "^4.3.5",
    "yet-another-react-lightbox": "^3.33.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/rss": "^0.0.32",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.32",
    "raw-loader": "^4.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
